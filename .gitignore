# ── dependencies ──────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── next.js ───────────────────────────────────────────────────────────────
/.next/
/out/
/build
next-env.d.ts

# ── production / deploy ───────────────────────────────────────────────────
.vercel
*.tsbuildinfo

# ── environment ───────────────────────────────────────────────────────────
# .env.local holds the price, Calendly URL, Razorpay key and CDN links.
# Never commit it. .env.example (committed) documents every key.
.env
.env*.local
.env.production

# ── logs / debug ──────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── os / editor ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# ── project-specific ──────────────────────────────────────────────────────
# Raw client media (453MB): source videos, unprocessed screenshots, original
# portraits. Derived, web-sized assets live in /public/img and ARE committed.
# Videos are served from the DigitalOcean CDN — see ASSETS.md.
/_source/

