# RESET · funnel environment — TEMPLATE
# Copy to .env.local and fill in. Every key is read through lib/config.js;
# nothing is inlined into a component, so a price change is one edit here.
#
# ⚠ NEXT_PUBLIC_* vars are baked into the bundle at build/start, NOT read at
#   runtime. After editing, RESTART the dev server — otherwise you will see a
#   stale value and think the change did not work.
#
# Blank values are deliberate: the UI renders a visible [gap] chip for each
# missing fact rather than inventing one. See QUESTIONS-FOR-CLIENT.txt.

# ---- commercial ------------------------------------------------------------
NEXT_PUBLIC_ENTRY_PRICE_INR=
NEXT_PUBLIC_CURRENCY=
NEXT_PUBLIC_PROGRAMME_WEEKS=
NEXT_PUBLIC_CALL_MINUTES=

# ---- third party -----------------------------------------------------------
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_VSL_VIMEO_URL=
NEXT_PUBLIC_VSL_POSTER=
NEXT_PUBLIC_RAZORPAY_KEY=

# ---- legal entity (required for Razorpay merchant verification) ------------
# Must match the entity on the Razorpay account exactly, or verification fails.
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_JURISDICTION=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_POLICY_UPDATED=

# ---- contact ---------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_CANONICAL_HOST=

# ---- proof numbers ---------------------------------------------------------
NEXT_PUBLIC_CLIENT_COUNT=
NEXT_PUBLIC_SUCCESS_RATE=
NEXT_PUBLIC_YEARS_COACHING=
NEXT_PUBLIC_RATING=
NEXT_PUBLIC_RATING_COUNT=
NEXT_PUBLIC_GEOGRAPHY=
NEXT_PUBLIC_COUNTRIES=
NEXT_PUBLIC_KG_RANGE=

# ---- urgency (leave BOTH empty rather than inventing a deadline) -----------
NEXT_PUBLIC_COUNTDOWN_DEADLINE=
NEXT_PUBLIC_MONTHLY_INTAKE_CAP=

# ---- video testimonial CDN (see ASSETS.md) ---------------------------------
NEXT_PUBLIC_VIDEO_1=https://tgox-production-bucket.nyc3.cdn.digitaloceanspaces.com/client_funnel_videos/Shruti/video-output-BC1A520F-867A-4430-B17B-9D8DE64EA938-1.mp4
NEXT_PUBLIC_VIDEO_2=https://tgox-production-bucket.nyc3.cdn.digitaloceanspaces.com/client_funnel_videos/Shruti/IMG_0318.mp4
NEXT_PUBLIC_VIDEO_3=https://tgox-production-bucket.nyc3.cdn.digitaloceanspaces.com/client_funnel_videos/Shruti/Video-Testimonial1.MP4
